{
  "name": "clothswear",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build && tsup server/index.ts --format esm --platform node --target node22 --out-dir dist/server --sourcemap --clean",
    "start": "node dist/server/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typegen": "sanity schema extract --config-path ./sanity.schema.config.ts --path ./schema.json --force && sanity typegen generate",
    "studio": "sanity dev",
    "studio:build": "sanity build",
    "seed:sanity": "node scripts/seed-sanity.mjs",
    "seed:dry": "node scripts/seed-sanity.mjs --dry-run"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.5",
    "@clerk/clerk-react": "^5.61.3",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sanity/client": "^8.14.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "groq": "^6.21.0",
    "gsap": "^3.15.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.5",
    "sanity": "^6.21.0",
    "stripe": "^23.1.0",
    "styled-components": "^6.6.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "tsup": "^9.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@pierre/diffs": "1.6.2"
  }
}
