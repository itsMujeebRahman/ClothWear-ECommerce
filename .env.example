# Public storefront URL used for Stripe success/cancel redirects.
APP_URL=http://localhost:5173

# API port. The Vite dev server proxies /api to this port.
PORT=3001

# Leave blank when the SPA and API share an origin. Set an absolute URL when
# the API is deployed separately.
VITE_API_URL=

# Sanity project settings. The dataset may be private; tokens stay server-side.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=
VITE_SANITY_API_VERSION=2025-05-20

# Server-only Sanity tokens. Never expose these to the browser.
SANITY_API_READ_TOKEN=
SANITY_API_TOKEN=

# Clerk application keys.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional comma-separated list of allowed token origins.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Server-only Stripe keys. The storefront runs without them; checkout does not.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
